{
  "expo": {
    "name": "CleanRooms",
    "slug": "cleanrooms-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "scheme": "cleanrooms",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dk.cleanrooms.studio.demo",
      "icon": "./assets/images/app-icon.png",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#202a30",
        "foregroundImage": "./assets/images/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": true,
      "package": "dk.cleanrooms.studio.demo"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/app-icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "CleanRooms bruger din placering ved indstempling for at tjekke, om du er t\u00e6t p\u00e5 arbejdsstedet.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "motionUsagePermission": "Placeringsbiblioteket underst\u00f8tter bev\u00e6gelsesdata. CleanRooms indsamler ikke bev\u00e6gelsesdata eller anmoder om adgang til dem."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/images/splash-mark.png",
          "imageWidth": 96
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      "./plugins/with-quoted-react-native-script.cjs",
      [
        "expo-notifications",
        {
          "defaultChannel": "cleanrooms",
          "color": "#00684A",
          "enableBackgroundRemoteNotifications": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3514833e-c3fc-4059-a3a8-90365780f3e0"
      }
    },
    "owner": "jonash0504"
  }
}
