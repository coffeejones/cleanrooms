      "ios": {
        "buildConfiguration": "Release"
      }
    },
    "simulator": {
      "distribution": "internal",
      "developmentClient": false,
      "environment": "preview",
      "ios": {
        "simulator": true,
        "buildConfiguration": "Release"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6832566435"
      }
    }
  }
